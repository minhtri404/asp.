@model CMS.Data.Entities.OrderDetail

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa chi tiết đơn hàng";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h5 class="mb-0">XÁC NHẬN XÓA CHI TIẾT ĐƠN HÀNG</h5></div>
    <div class="card-body">
        <div class="alert alert-warning">Bạn có chắc chắn muốn xóa dòng sản phẩm <strong>@Model.Product?.Name</strong> trong đơn hàng #@Model.OrderId?</div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
