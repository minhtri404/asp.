@model IEnumerable<CMS.Data.Entities.Order>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">DANH SÁCH ĐƠN HÀNG</h2>
        <button class="btn btn-success btn-sm">+ Thêm đơn hàng</button>
    </div>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Ngày đặt</th>
                <th>Mã khách hàng</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.CustomerId</td>
                        <td>
                        @if (item.Status == 0)
                        {
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                        }
                        else if (item.Status == 1)
                        {
                                    <span class="badge bg-info text-dark">Đang giao</span>
                        }
                        else
                        {
                                    <span class="badge bg-success">Đã xong</span>
                        }
                        </td>
                        <td>@item.Notes</td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>