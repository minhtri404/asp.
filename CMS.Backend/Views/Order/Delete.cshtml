@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa đơn hàng";
    var total = Model.OrderDetails?.Sum(od => od.Quantity * od.UnitPrice) ?? 0;
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h5 class="mb-0">XÁC NHẬN XÓA ĐƠN HÀNG</h5></div>
    <div class="card-body">
        <div class="alert alert-warning">Bạn có chắc chắn muốn xóa đơn hàng #@Model.Id?</div>
        <p><strong>Khách hàng:</strong> @Model.Customer?.FullName</p>
        <p><strong>Tổng tiền:</strong> @total.ToString("N0") VNĐ</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
