@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa đơn hàng";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning"><h5 class="mb-0">CẬP NHẬT ĐƠN HÀNG #@Model.Id</h5></div>
    <div class="card-body">
        <p><strong>Khách hàng:</strong> @Model.Customer?.FullName</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
      <form action="/Order/Edit/@Model.Id" method="post">
            @Html.AntiForgeryToken()        
            <div class="mb-3">
                <label class="form-label fw-bold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="0" selected="@(Model.Status == 0)">Chờ duyệt</option>
                    <option value="1" selected="@(Model.Status == 1)">Đang giao</option>
                    <option value="2" selected="@(Model.Status == 2)">Đã xong</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Ghi chú</label>
                <textarea name="notes" class="form-control" rows="4">@Model.Notes</textarea>
            </div>
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
