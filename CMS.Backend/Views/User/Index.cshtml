@model CMS.Backend.Models.PaginatedList<CMS.Data.Entities.User>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}

@if (User.IsInRole("Editor"))
{
    <div class="alert alert-danger">
        Editor chỉ được thao tác Bài viết. Các mục khác chỉ được xem, không được thêm, sửa hoặc xóa.
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-dark mb-0">QUẢN LÝ THÀNH VIÊN</h2>
    <a asp-action="Create" class="btn btn-success btn-sm">+ Thêm thành viên mới</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm username, họ tên, quyền" />
        </div>
        <div class="col-md-2">
            <select name="role" class="form-select">
                <option value="">Tất cả quyền</option>
                <option value="Admin" selected="@(ViewBag.Role == "Admin")">Admin</option>
                <option value="Editor" selected="@(ViewBag.Role == "Editor")">Editor</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="">Tên A-Z</option>
                <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Tên Z-A</option>
                <option value="role_asc" selected="@(ViewBag.SortOrder == "role_asc")">Quyền A-Z</option>
                <option value="role_desc" selected="@(ViewBag.SortOrder == "role_desc")">Quyền Z-A</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select">
                <option value="10" selected="@((int)ViewBag.PageSize == 10)">10 dòng</option>
                <option value="20" selected="@((int)ViewBag.PageSize == 20)">20 dòng</option>
                <option value="50" selected="@((int)ViewBag.PageSize == 50)">50 dòng</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
        </div>
    </div>
</form>

<table class="table table-hover shadow-sm border bg-white">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Tên đăng nhập</th>
            <th>Họ và tên</th>
            <th>Quyền hạn</th>
            <th style="width:180px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td><strong>@user.Username</strong></td>
                <td>@user.FullName</td>
                <td>
                    @if (user.Role == "Admin")
                    {
                        <span class="badge bg-danger">@user.Role</span>
                    }
                    else if (user.Role == "Editor")
                    {
                        <span class="badge bg-info text-dark">@user.Role</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@user.Role</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-danger"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này không?')">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có dữ liệu phù hợp.</div>
}

@await Html.PartialAsync("_AdminPager", Model)
