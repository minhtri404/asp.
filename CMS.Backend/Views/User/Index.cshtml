@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
}
@if (User.IsInRole("Editor"))
{
        <div class="alert alert-danger">
            Editor chỉ được thao tác Bài viết. Các mục khác chỉ được xem, không được thêm, sửa hoặc xóa.
        </div>
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ THÀNH VIÊN</h2>
        <button class="btn btn-success btn-sm">+ Thêm thành viên mới</button>
    </div>

    <table class="table table-hover shadow-sm border">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Tên Đăng Nhập</th>
                <th>Họ Và Tên</th>
                <th>Quyền Hạn</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                    <tr>
                        <td>@user.Id</td>
                        <td><strong>@user.Username</strong></td>
                        <td>@user.FullName</td>
                        <td>
                        @if (user.Role == "Admin")
                        {
                                    <span class="badge bg-danger">@user.Role</span>
                        }
                        else if (user.Role == "Editor")
                        {
                                    <span class="badge bg-info text-dark">@user.Role</span>
                        }
                        else
                        {
                                    <span class="badge bg-secondary">@user.Role</span>
                        }
                        </td>
                        <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">
        Sửa
    </a>

    <a asp-action="Delete" asp-route-id="@user.Id"
       class="btn btn-sm btn-outline-danger"
       onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này không?')">
        Xóa
    </a>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>