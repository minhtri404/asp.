@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h5 class="mb-0">XÁC NHẬN XÓA SẢN PHẨM</h5></div>
    <div class="card-body">
        <div class="alert alert-warning">Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong>?</div>
        <p><strong>Danh mục:</strong> @Model.CategoryProduct?.Name</p>
        <p><strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ</p>
        <p><strong>Tồn kho:</strong> @Model.StockQuantity</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
