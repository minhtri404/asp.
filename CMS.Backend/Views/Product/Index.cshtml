@model IEnumerable<CMS.Data.Entities.Product>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="text-primary mb-4">DANH SÁCH SẢN PHẨM</h2>

    <div class="row">
        @foreach (var item in Model)
        {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:180px; object-fit:cover;">

                        <div class="card-body">
                            <h5 class="card-title text-dark">@item.Name</h5>
                            <p class="card-text text-muted">@item.Description</p>

                            <p>
                                <strong>Giá:</strong>
                            @item.Price.ToString("N0") VNĐ
                            </p>

                            <p>
                                <strong>Tồn kho:</strong>
                            @item.StockQuantity
                            </p>

                            <button class="btn btn-sm btn-outline-warning">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>