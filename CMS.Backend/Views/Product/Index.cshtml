@model CMS.Backend.Models.PaginatedList<CMS.Data.Entities.Product>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary mb-0">DANH SÁCH SẢN PHẨM</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tên, mô tả, danh mục" />
        </div>
        <div class="col-md-2">
            <select name="categoryProductId" asp-items="ViewBag.CategoryProductList" class="form-select">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-md-1">
            <input name="minPrice" value="@ViewBag.MinPrice" class="form-control" placeholder="Giá từ" />
        </div>
        <div class="col-md-1">
            <input name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" placeholder="Giá đến" />
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="">Tên A-Z</option>
                <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá tăng</option>
                <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá giảm</option>
                <option value="stock_asc" selected="@(ViewBag.SortOrder == "stock_asc")">Tồn kho tăng</option>
                <option value="stock_desc" selected="@(ViewBag.SortOrder == "stock_desc")">Tồn kho giảm</option>
            </select>
        </div>
        <div class="col-md-1">
            <select name="pageSize" class="form-select">
                <option value="9" selected="@((int)ViewBag.PageSize == 9)">9</option>
                <option value="18" selected="@((int)ViewBag.PageSize == 18)">18</option>
                <option value="36" selected="@((int)ViewBag.PageSize == 36)">36</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:180px; object-fit:cover;">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">Chưa có ảnh</div>
                }
                <div class="card-body">
                    <h5 class="card-title text-dark">@item.Name</h5>
                    <p class="card-text text-muted">@item.Description</p>
                    <p><strong>Danh mục:</strong> @item.CategoryProduct?.Name</p>
                    <p><strong>Giá:</strong> @item.Price.ToString("N0") VNĐ</p>
                    <p><strong>Tồn kho:</strong> @item.StockQuantity</p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có dữ liệu phù hợp.</div>
}

@await Html.PartialAsync("_AdminPager", Model)

