@model CMS.Data.Entities.Post

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <a href="/Post" class="btn btn-secondary btn-sm mb-3">
                Quay lại danh sách
            </a>

            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>

            <p class="text-muted">
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <span class="badge bg-secondary">
                    @(Model.Category != null ? Model.Category.Name : "Chưa có danh mục")
                </span>
            </p>

            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height:400px; object-fit:cover;">
                </div>
            }

            <div class="fs-5">
                @Html.Raw(Model.Content)
            </div>
        </div>
    </div>
</div>
