@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-dark">DANH SÁCH BÀI VIẾT</h2>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height:180px; object-fit:cover;">

                    <div class="card-body">
                        <span class="badge bg-info text-dark">
                        @(item.Category != null ? item.Category.Name : "Chưa có danh mục")
                        </span>

                        <h5 class="card-title text-primary mt-2">@item.Title</h5>

                        <p class="card-text text-truncate">
                        @Html.Raw(item.Content)
                        </p>

                        <p class="text-muted small">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            Xem chi tiết
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                            Sửa
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                            Xóa
                        </a>
                    </div>
                </div>
            </div>
    }
</div>