@model IEnumerable<CMS.Data.Entities.Post>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    <div class="row">
        @foreach (var item in Model)
        {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height:180px; object-fit:cover;">

                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Title</h5>
                            <p class="card-text text-truncate">@item.Content</p>
                            <p class="text-muted small">
                                Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>
                            <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>