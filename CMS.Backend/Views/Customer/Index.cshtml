@model IEnumerable<CMS.Data.Entities.Customer>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Khách hàng";
}
@if (User.IsInRole("Editor"))
{
        <div class="alert alert-danger">
            Editor chỉ được thao tác Bài viết. Các mục khác chỉ được xem, không được thêm, sửa hoặc xóa.
        </div>
}

    <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary mb-0">DANH SÁCH KHÁCH HÀNG</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm khách hàng</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-10">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tên, email, số điện thoại, địa chỉ" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </div>
</form>

<table class="table table-bordered table-hover shadow-sm bg-white">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>SĐT</th>
            <th>Địa chỉ</th>
            <th style="width:260px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.FullName</strong></td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
