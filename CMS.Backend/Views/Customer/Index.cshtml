@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý khách hàng";
}



    <form method="get" action="/Customer" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control"
                   placeholder="Tìm theo họ tên, email, số điện thoại, địa chỉ..." />

            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a href="/Customer" class="btn btn-outline-secondary">
                Làm mới
            </a>
        </div>
    </form>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.FullName</strong></td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.Address</td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>