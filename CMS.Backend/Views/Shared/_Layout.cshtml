<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TriCMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>



<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">TriCMS</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" href="/Category">Danh mục bài viết</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Post">Bài viết</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/User">Người dùng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/CategoryProduct">Danh mục sản phẩm</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Product">Sản phẩm</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Customer">Khách hàng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Order">Đơn hàng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/OrderDetail">Chi tiết đơn hàng</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="border-top mt-5 py-3 text-center text-muted">
        <small>TriCMS - ASP.NET Core MVC - Buổi 2</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>