<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TriCMS Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f4f6f9;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #0d1b2a;
            color: white;
        }

        .sidebar .brand {
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            text-align: center;
        }

        .sidebar a {
            color: #d6dce5;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            font-size: 15px;
        }

        .sidebar a:hover {
            background-color: #1b263b;
            color: white;
        }

        .content-area {
            padding: 25px;
        }

        .top-title {
            background: white;
            border-radius: 10px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
    </style>
</head>

<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="px-3 py-2 text-white">
            Xin chào, <strong>@User.Identity.Name</strong>
        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger btn-sm">
                Đăng xuất
            </button>
        </form>
    }
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-0">
                <div class="brand">
                    <h4 class="mb-0">TriCMS Admin</h4>
                    <small>Hệ thống quản trị</small>
                </div>

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Bảng điều khiển
                    </a>

                    <a asp-controller="Category" asp-action="Index">
                        <i class="bi bi-grid"></i> Quản lý Danh mục
                    </a>

                    <a asp-controller="Post" asp-action="Index">
                        <i class="bi bi-file-earmark-post"></i> Quản lý Bài viết
                    </a>

                    <a asp-controller="Advertisement" asp-action="Index">
                        <i class="bi bi-badge-ad"></i> Quảng cáo
                    </a>

                    <a asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i> Quản lý Thành viên
                    </a>

                    <a asp-controller="CategoryProduct" asp-action="Index">
                        <i class="bi bi-tags"></i> Danh mục sản phẩm
                    </a>

                    <a asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Sản phẩm
                    </a>

                    <a asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Khách hàng
                    </a>

                    <a asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i> Đơn hàng
                    </a>

                    <a asp-controller="OrderDetail" asp-action="Index">
                        <i class="bi bi-list-check"></i> Chi tiết đơn hàng
                    </a>
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 content-area">
                <div class="top-title">
                    <h5 class="mb-0">Trang quản trị nội dung</h5>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                        <div class="alert alert-success alert-dismissible fade show">
                        @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
