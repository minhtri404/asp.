@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa danh mục";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white"><h5 class="mb-0">XÁC NHẬN XÓA DANH MỤC</h5></div>
    <div class="card-body">
        <div class="alert alert-warning">Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong>?</div>
        <p><strong>ID:</strong> @Model.Id</p>
        <p><strong>Mô tả:</strong> @Model.Description</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
