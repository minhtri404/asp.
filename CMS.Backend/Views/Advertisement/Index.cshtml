@model CMS.Backend.Models.PaginatedList<CMS.Data.Entities.Advertisement>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quảng cáo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary mb-0">DANH SÁCH BANNER QUẢNG CÁO</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm banner
    </a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tiêu đề, mô tả" />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active" selected="@(ViewBag.Status == "active")">Đang bật</option>
                <option value="inactive" selected="@(ViewBag.Status == "inactive")">Đang tắt</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select">
                <option value="10" selected="@((int)ViewBag.PageSize == 10)">10 dòng</option>
                <option value="20" selected="@((int)ViewBag.PageSize == 20)">20 dòng</option>
                <option value="50" selected="@((int)ViewBag.PageSize == 50)">50 dòng</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover shadow-sm bg-white align-middle">
        <thead class="table-light">
            <tr>
                <th style="width:90px;">Ảnh</th>
                <th>Nội dung</th>
                <th style="width:100px;">Thứ tự</th>
                <th style="width:120px;">Trạng thái</th>
                <th style="width:240px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" class="rounded border" style="width:72px; height:48px; object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">Chưa có ảnh</span>
                        }
                    </td>
                    <td>
                        <strong>@item.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <div class="text-muted small">@item.Subtitle</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                        {
                            <div class="small">Link: @item.LinkUrl</div>
                        }
                    </td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Đang bật</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Đang tắt</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có banner phù hợp.</div>
}

@await Html.PartialAsync("_AdminPager", Model)
